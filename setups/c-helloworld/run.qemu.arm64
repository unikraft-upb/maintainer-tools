#!/bin/sh

if test ! -f "out/helloworld_qemu-arm64"; then
    echo "No kernel file out/helloworld_qemu-arm64." 1>&2
    echo "Did you run ./build.qemu.arm64 ?" 1>&2
    exit 1
fi

sudo qemu-system-aarch64 \
    -nographic \
    -machine virt \
    -m 8 \
    -kernel out/helloworld_qemu-arm64 \
    -cpu max
